# Para trabajar contra los emuladores locales (npm run emu + npm run dev:emu).
# Cópialo como .env.local: Vite lo carga por encima de .env y no se sube a git.
# Con el emulador los valores no se validan; basta que existan.
VITE_FB_API_KEY=demo-api-key
VITE_FB_AUTH_DOMAIN=demo-fichas.firebaseapp.com
VITE_FB_PROJECT_ID=demo-fichas
VITE_FB_STORAGE_BUCKET=demo-fichas.appspot.com
VITE_FB_SENDER_ID=000000000000
VITE_FB_APP_ID=1:000000000000:web:0000000000000000
VITE_FB_DATABASE_URL=http://127.0.0.1:9000/?ns=demo-fichas-default-rtdb
VITE_USE_EMULATOR=true
