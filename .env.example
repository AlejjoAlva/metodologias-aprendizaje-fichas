# Copia este archivo como .env y pega los valores de TU proyecto de Firebase
# (Consola > Configuración del proyecto > Tus apps > Web > SDK setup and configuration > Config).
# Con la CLI:  firebase apps:sdkconfig WEB <appId>
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_SENDER_ID=
VITE_FB_APP_ID=
# Realtime Database (presencia). Forma: https://<tu-proyecto>-default-rtdb.firebaseio.com
VITE_FB_DATABASE_URL=

# "true" para apuntar a los emuladores locales (npm run emu); "false" para el proyecto real.
VITE_USE_EMULATOR=false
